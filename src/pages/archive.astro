---
import Base from '../layouts/Base.astro';
import { getStories, metaLine, tagCounts } from '../lib/content.js';
import { heroName } from '../lib/vt.js';

const stories = await getStories();
const tags = tagCounts(stories);
const newestSlug = stories.find((s) => s.featured)?.slug;
---

<Base title="Archive" description="Every amoura wedding story — films and photographs, filterable by place and mood." view="archive">
  <main class="page archive">
    <header class="archive__head">
      <p class="label label--dim" data-reveal>Archive</p>
      <h1 class="display" data-reveal style="--d:.06s">Every story.</h1>
      <p class="label" data-reveal style="--d:.12s"><span data-count>{stories.length}</span> stories</p>
    </header>

    <div class="chips" role="group" aria-label="Filter by tag" data-reveal style="--d:.16s">
      <button type="button" class="chip label" data-tag="" aria-pressed="true">All <sup>{stories.length}</sup></button>
      {
        tags.map(([t, n]) => (
          <button type="button" class="chip label" data-tag={t} aria-pressed="false">
            {t} <sup>{n}</sup>
          </button>
        ))
      }
    </div>

    <ul class="grid">
      {
        stories.map((s, i) => (
          <li class="card" data-tags={JSON.stringify(s.tags)}>
            <a href={`/story/${s.slug}`} data-cursor="view" data-cursor-label="View story →">
              <span class="card__frame" style={s.coverLqip ? `background-image:url(${s.coverLqip})` : ''}>
                <img
                  src={s.coverSm}
                  alt=""
                  loading={i < 6 ? 'eager' : 'lazy'}
                  decoding="async"
                  style={`view-transition-name:${heroName(s.slug)}`}
                />
                {s.slug === newestSlug && <span class="badge-new card__new">NEW</span>}
              </span>
              <span class="card__title">{s.title}</span>
              <span class="label label--dim">{metaLine(s).join(' · ')}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="empty label" data-empty hidden>No stories with that tag yet.</p>
  </main>
</Base>

<style>
  .archive__head { display: grid; gap: 18px; margin-bottom: 48px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 56px; }
  .chip { height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-2); transition: all 0.45s var(--ease); }
  .chip sup { font-size: 8px; color: var(--ink-3); margin-left: 2px; }
  .chip:hover { border-color: var(--line-2); color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .chip[aria-pressed='true'] sup { color: var(--bg); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: clamp(28px, 3vw, 44px) clamp(16px, 2vw, 28px); }
  .card { transition: opacity 0.5s var(--ease), transform 0.5s var(--ease); }
  .card[hidden] { display: none; }
  .card a { display: grid; gap: 10px; }
  .card__frame { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 4px; background: var(--bg-3) center / cover no-repeat; }
  .card__frame img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.9) brightness(0.92); transition: transform 1.4s var(--ease), filter 0.8s var(--ease); }
  .card a:hover .card__frame img { transform: scale(1.04); filter: saturate(1.02) brightness(1); }
  .card__new { position: absolute; left: 12px; top: 12px; }
  .card__title { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.9rem; line-height: 1.05; margin-top: 6px; }
  .empty { padding: 60px 0; }
</style>

<script>
  import { onPage } from '../scripts/lifecycle.js';

  onPage(() => {
    const chips = [...document.querySelectorAll('.chip[data-tag]')];
    if (!chips.length) return;
    const cards = [...document.querySelectorAll('.card[data-tags]')];
    const count = document.querySelector('[data-count]');
    const empty = document.querySelector('[data-empty]');

    function apply(tag, push = true) {
      let n = 0;
      for (const c of cards) {
        const show = !tag || JSON.parse(c.dataset.tags).includes(tag);
        c.hidden = !show;
        if (show) n++;
      }
      chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
      count.textContent = String(n);
      empty.hidden = n > 0;
      if (push) {
        const url = new URL(location.href);
        if (tag) url.searchParams.set('tag', tag);
        else url.searchParams.delete('tag');
        history.replaceState(history.state, '', url);
      }
    }

    const onClick = (e) => apply(e.currentTarget.dataset.tag);
    chips.forEach((b) => b.addEventListener('click', onClick));
    const initial = new URL(location.href).searchParams.get('tag');
    if (initial && chips.some((b) => b.dataset.tag === initial)) apply(initial, false);
    return () => chips.forEach((b) => b.removeEventListener('click', onClick));
  });
</script>
