---
// Home: the spiral opening → the memory corridor (scroll-driven) → everything a couple
// needs to say yes: kind words, where we've been, collections, how we work, enquiry.
import CorridorScroll from '../components/CorridorScroll.astro';
import Enquire from '../components/Enquire.astro';
import Globe from '../components/Globe.astro';
import Packages from '../components/Packages.astro';
import Quotes from '../components/Quotes.astro';
import Spiral from '../components/Spiral.astro';
import Base from '../layouts/Base.astro';
import { sales, studio } from '../data.js';
import { WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from '../lib/config.js';
import { getCorridor, getSpiral, getStories } from '../lib/content.js';

const all = await getStories();
const spiral = await getSpiral(); // "Show in spiral" weddings
const corridor = await getCorridor(); // 8 latest + pinned
const featured = corridor;
const spiralImages = [
  ...spiral.map((s) => ({ src: s.coverSm, aspect: s.coverAspect })),
  ...spiral.flatMap((s) => s.media.filter((m) => m.type === 'image').slice(0, 2).map((m) => ({ src: m.thumb, aspect: m.aspect }))),
].slice(0, 20);
const whatsapp = WHATSAPP_NUMBER ? `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}` : '#enquire';
const waAttrs = WHATSAPP_NUMBER ? { target: '_blank', rel: 'noopener' } : {};
const pad = (n: number) => String(n).padStart(2, '0');
const sections = [
  ['#stories', 'Stories'],
  ['#words', 'Kind words'],
  ['#where', 'Places'],
  ['#packages', 'Collections'],
  ['#process', 'How we work'],
  ['#enquire', 'Enquire'],
];
---

<Base view="gallery" talk="#enquire" bodyClass="home" image={featured[0]?.cover}>
  <Spiral images={spiralImages} />
  <CorridorScroll stories={corridor} />

  <div class="below" id="after" data-chrome-solid-from>
    <nav class="secnav" data-secnav aria-label="On this page">
      <ul class="secnav__list label">
        {
          sections.map(([href, label]) => (
            <li>
              <a href={href} data-secnav-link class:list={{ secnav__talk: href === '#enquire' }}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="archive-row" href="/archive" data-cursor="view" data-cursor-label="Archive →">
      <span class="label label--dim">{all.length} stories in the archive</span>
      <span class="display display--sm">See every story <span aria-hidden="true">→</span></span>
    </a>

    <section class="band" id="words" aria-label="Kind words">
      <Quotes />
    </section>

    <section class="band" id="where" aria-label="Where we’ve been">
      <Globe />
    </section>

    <section class="band" id="packages" aria-label="Collections">
      <Packages />
    </section>

    <section class="band" id="process" aria-label="How we work">
      <div class="process__head">
        <p class="label label--dim">How we work</p>
        <h2 class="display process__title">Four quiet steps.</h2>
      </div>
      <ol class="steps">
        {
          studio.process.map(([t, d], i) => (
            <li data-reveal style={`--d:${i * 0.06}s`}>
              <span class="label">{pad(i + 1)}</span>
              <span class="display display--sm">{t}</span>
              <p>{d}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="band enquire-wrap" id="enquire" aria-label="Enquire" data-enquire-section>
      <div class="enquire-wrap__intro">
        <p class="label label--dim">Enquire</p>
        <h2 class="display enquire-wrap__title">Tell us about your day.</h2>
        <p class="muted">We reply within a day. Prefer to talk? <a class="link-arrow" href={whatsapp} {...waAttrs}>WhatsApp us</a></p>
      </div>
      <Enquire />
    </section>

    <footer class="foot">
      <span class="foot__logo">amoura<sup>®</sup></span>
      <span class="label label--dim">Paris · Dubai · anywhere</span>
      <span class="label label--dim">© {new Date().getFullYear()}</span>
    </footer>
  </div>

  <!-- WhatsApp, always one tap away -->
  <a class="wa" href={whatsapp} {...waAttrs} aria-label="WhatsApp" data-wa>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"></path></svg>
  </a>
</Base>

<style>
  .below { position: relative; background: var(--bg); }

  /* section menu: pinned under the header once you're past the corridor */
  .secnav { position: sticky; top: 70px; z-index: 50; display: flex; justify-content: center; padding: 14px var(--gutter) 0; pointer-events: none; transition: top 0.5s var(--ease); }
  .secnav__list { pointer-events: auto; list-style: none; margin: 0; padding: 4px; display: flex; gap: 2px; border-radius: 999px; border: 1px solid var(--line); background: rgba(16, 13, 11, 0.72); backdrop-filter: blur(16px) saturate(1.2); -webkit-backdrop-filter: blur(16px) saturate(1.2); max-width: 100%; overflow-x: auto; scrollbar-width: none; }
  .secnav__list::-webkit-scrollbar { display: none; }
  .secnav a { display: inline-flex; align-items: center; height: 36px; padding: 0 14px; border-radius: 999px; color: var(--ink-3); white-space: nowrap; transition: color 0.4s var(--ease), background 0.4s var(--ease); }
  @media (hover: hover) { .secnav a:hover { color: var(--ink); } }
  .secnav a[aria-current='true'] { color: var(--ink); background: rgba(236, 228, 218, 0.1); }
  .secnav a.secnav__talk { color: var(--rose); }

  .archive-row { display: grid; gap: 10px; max-width: 1560px; margin: 90px auto 0; padding: 34px var(--gutter); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: padding 0.6s var(--ease); }
  @media (hover: hover) { .archive-row:hover { padding-left: calc(var(--gutter) + 18px); } }

  .band { max-width: 1560px; margin: 0 auto; padding: 16vh var(--gutter) 0; scroll-margin-top: 130px; }

  .sample { color: #e9c08f; border: 1px dashed rgba(233, 192, 143, 0.5); padding: 5px 10px; border-radius: 999px; font-size: 9.5px; }


  .process__head { display: grid; gap: 14px; margin-bottom: 48px; }
  .process__title { font-size: clamp(3rem, 7vw, 6.5rem); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .steps li { display: grid; gap: 10px; align-content: start; padding-top: 20px; border-top: 1px solid var(--line); }
  .steps p { margin: 0; color: var(--ink-2); }

  .enquire-wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: clamp(32px, 6vw, 110px); align-items: start; }
  .enquire-wrap__intro { display: grid; gap: 16px; position: sticky; top: 160px; }
  .enquire-wrap__title { font-size: clamp(2.6rem, 5vw, 4.6rem); }

  .foot { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; flex-wrap: wrap; margin-top: 16vh; padding: 40px var(--gutter) 110px; border-top: 1px solid var(--line); }
  .foot__logo { font-family: var(--serif); font-style: italic; font-size: 26px; }
  .foot__logo sup { font-family: var(--mono); font-style: normal; font-size: 9px; }

  .wa {
    position: fixed; right: var(--gutter); bottom: 86px; z-index: 62;
    width: 50px; height: 50px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(22, 19, 17, 0.8); border: 1px solid var(--line-2); color: var(--ink);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
    transition: transform 0.5s var(--ease), opacity 0.5s var(--ease), background 0.4s var(--ease);
  }
  @media (hover: hover) { .wa:hover { background: #25d366; color: #0b1a10; border-color: transparent; } }
  .wa:global(.is-away) { opacity: 0; transform: translateY(20px); pointer-events: none; }

  @media (max-width: 760px) {
    .secnav { top: calc(max(12px, env(safe-area-inset-top)) + 58px); padding-top: 10px; }
    :global(html.chrome-hidden) .secnav { top: calc(max(6px, env(safe-area-inset-top))); }
    .secnav a { height: 34px; padding: 0 11px; font-size: 10px; letter-spacing: 0.1em; }
    .archive-row { margin-top: 56px; }
    .band { padding-top: 96px; scroll-margin-top: 110px; }
        .process__head { margin-bottom: 24px; }
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps li { grid-template-columns: 34px 1fr; gap: 4px 12px; padding: 16px 0; }
    .steps li .label { grid-row: 1 / span 2; padding-top: 8px; }
    .enquire-wrap { grid-template-columns: 1fr; gap: 28px; }
    .enquire-wrap__intro { position: static; }
    .wa { right: 14px; bottom: calc(max(12px, env(safe-area-inset-bottom)) + 66px); width: 46px; height: 46px; }
    :global(html.chrome-hidden) .wa { bottom: calc(max(12px, env(safe-area-inset-bottom)) + 4px); }
    .foot { margin-top: 96px; padding-bottom: calc(110px + env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) {
    }
</style>

<script>
  import { onPage } from '../scripts/lifecycle.js';
  import { startSmoothScroll } from '../scripts/smooth.js';

  onPage(() => {
    const secnav = document.querySelector('[data-secnav]');
    if (!secnav) return;
    const smooth = startSmoothScroll();

    // Highlight the section you're in; tuck WhatsApp away while the form is on screen.
    const links = [...secnav.querySelectorAll('[data-secnav-link]')];
    const targets = links.map((a) => document.querySelector(a.getAttribute('href')));
    const wa = document.querySelector('[data-wa]');
    const enquire = document.querySelector('[data-enquire-section]');
    let raf = 0;
    const tick = () => {
      raf = 0;
      const vh = window.innerHeight;
      let cur = -1;
      targets.forEach((el, i) => {
        if (el && el.getBoundingClientRect().top <= vh * 0.4) cur = i;
      });
      links.forEach((a, i) => (i === cur ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      if (wa && enquire) {
        const r = enquire.getBoundingClientRect();
        wa.classList.toggle('is-away', r.top < vh * 0.8 && r.bottom > 0);
      }
    };
    const onScroll = () => (raf ||= requestAnimationFrame(tick));
    window.addEventListener('scroll', onScroll, { passive: true });
    tick();

    return () => {
      window.removeEventListener('scroll', onScroll);
      cancelAnimationFrame(raf);
      smooth.destroy();
    };
  });
</script>
