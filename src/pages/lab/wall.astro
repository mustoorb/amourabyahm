---
import Base from '../../layouts/Base.astro';
import { getFeatured } from '../../lib/content.js';

const featured = await getFeatured();
// Tile pool: each featured cover plus a couple of its photos.
const tiles = featured.flatMap((s) => [
  { slug: s.slug, title: s.title, src: s.coverSm, aspect: s.coverAspect },
  ...s.media.filter((m) => m.type === 'image').slice(0, 2).map((m) => ({ slug: s.slug, title: s.title, src: m.thumb, aspect: m.aspect })),
]);
---

<Base title="Lab — Memory Wall" noindex bodyClass="is-home">
  <div class="wall" data-wall data-tiles={JSON.stringify(tiles)} aria-label="Memory wall — drag to explore"></div>
  <p class="wall__hint label label--dim">Drag to wander · click to open</p>
</Base>

<style is:global>
  body.is-home { overflow: hidden; }
  .wall { position: fixed; inset: 0; overflow: hidden; touch-action: none; cursor: grab; }
  .wall:active { cursor: grabbing; }
  .wall__layer { position: absolute; left: 0; top: 0; will-change: transform; }
  .wall__tile { position: absolute; display: block; overflow: hidden; border-radius: 4px; background: var(--bg-3); }
  .wall__tile img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; filter: saturate(0.9) brightness(0.9); transition: filter 0.6s var(--ease), transform 1.2s var(--ease); }
  .wall__tile:hover img { filter: saturate(1.05) brightness(1.02); transform: scale(1.04); }
  .wall__hint { position: fixed; left: 50%; bottom: 80px; transform: translateX(-50%); z-index: 5; }
</style>

<script>
  import { onPage, prefersReducedMotion } from '../../scripts/lifecycle.js';

  onPage(() => {
    const wall = document.querySelector('[data-wall]');
    if (!wall) return;
    const tiles = JSON.parse(wall.dataset.tiles);
    const reduced = prefersReducedMotion();

    // Three depth layers, each a repeating cell of tiles, wrapped with modulo.
    const LAYERS = [
      { speed: 0.45, scale: 0.5, opacity: 0.3, blur: 3 },
      { speed: 0.7, scale: 0.72, opacity: 0.6, blur: 1 },
      { speed: 1, scale: 1, opacity: 1, blur: 0 },
    ];
    const COLS = 5;
    const BASE = Math.max(180, Math.min(300, window.innerWidth / 5));
    const layers = LAYERS.map((cfg, li) => {
      const el = document.createElement('div');
      el.className = 'wall__layer';
      el.style.opacity = String(cfg.opacity);
      if (cfg.blur) el.style.filter = `blur(${cfg.blur}px)`;
      const w = BASE * cfg.scale;
      const gap = w * 0.75;
      const colW = w + gap;
      const rows = Math.ceil(tiles.length / COLS);
      const cellW = COLS * colW;
      const cellH = rows * (w * 1.3 + gap);
      const items = [];
      // Enough copies of the cell to cover the viewport while wrapping.
      const nx = Math.ceil(window.innerWidth / cellW) + 1;
      const ny = Math.ceil(window.innerHeight / cellH) + 1;
      for (let cx = 0; cx < nx; cx++)
        for (let cy = 0; cy < ny; cy++)
          tiles.forEach((t, i) => {
            if ((i + li) % (li === 2 ? 1 : 2)) return;
            const k = (i + li * 3) % tiles.length;
            const tile = tiles[k];
            const a = document.createElement('a');
            a.className = 'wall__tile';
            a.href = `/story/${tile.slug}`;
            a.draggable = false;
            a.setAttribute('aria-label', tile.title);
            a.dataset.cursor = 'view';
            a.dataset.cursorLabel = 'View story →';
            const h = w / Math.min(1.5, Math.max(0.66, tile.aspect));
            const col = i % COLS;
            const row = Math.floor(i / COLS);
            const x = cx * cellW + col * colW + ((row % 2) * colW) / 2;
            const y = cy * cellH + row * (w * 1.3 + gap) + ((col * 37) % 60);
            Object.assign(a.style, { left: `${x}px`, top: `${y}px`, width: `${w}px`, height: `${h}px` });
            const img = document.createElement('img');
            img.src = tile.src;
            img.alt = '';
            img.loading = 'lazy';
            img.decoding = 'async';
            a.append(img);
            el.append(a);
            items.push(a);
          });
      wall.append(el);
      return { el, cfg, cellW, cellH };
    });

    let x = 0, y = 0, tx = 0, ty = 0, vx = 0, vy = 0;
    let drag = null;
    let moved = 0;
    const down = (e) => {
      drag = { x: e.clientX, y: e.clientY };
      moved = 0;
      vx = vy = 0;
    };
    const move = (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      drag = { x: e.clientX, y: e.clientY };
      moved += Math.abs(dx) + Math.abs(dy);
      tx += dx;
      ty += dy;
      vx = dx;
      vy = dy;
    };
    const up = () => (drag = null);
    const click = (e) => {
      if (moved > 6) e.preventDefault();
    };
    const wheel = (e) => {
      e.preventDefault();
      tx -= e.deltaX;
      ty -= e.deltaY;
    };
    wall.addEventListener('pointerdown', down);
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
    wall.addEventListener('click', click, true);
    wall.addEventListener('wheel', wheel, { passive: false });

    const mod = (a, n) => ((a % n) + n) % n;
    let raf = 0;
    const loop = () => {
      raf = requestAnimationFrame(loop);
      if (!drag && !reduced) {
        tx += vx;
        ty += vy;
        vx *= 0.92;
        vy *= 0.92;
      }
      x += (tx - x) * (reduced ? 1 : 0.1);
      y += (ty - y) * (reduced ? 1 : 0.1);
      for (const l of layers) {
        const lx = mod(x * l.cfg.speed, l.cellW) - l.cellW;
        const ly = mod(y * l.cfg.speed, l.cellH) - l.cellH;
        l.el.style.transform = `translate3d(${lx}px, ${ly}px, 0)`;
      }
    };
    loop();

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
    };
  });
</script>
