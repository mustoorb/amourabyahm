---
// Archive v2 preview — a Cash App-style infinite canvas of every story (desktop).
// Drag or scroll to wander, pinch / +/− to zoom, frames float and turn as you move.
// Phones (and touch screens) get the two-up grid instead.
import Base from '../../layouts/Base.astro';
import { getStories, tagCounts } from '../../lib/content.js';
import { heroName } from '../../lib/vt.js';

const stories = await getStories();
const tags = tagCounts(stories);
const newest = stories.find((s) => s.featured)?.slug;
const COPIES = 3; // world is tiled 3×3 so it wraps seamlessly in every direction
---

<Base title="Archive — preview" noindex view="archive" bodyClass="av2-body">
  <h1 class="sr-only">Archive — every story</h1>

  <!-- desktop canvas -->
  <section class="canvas" data-canvas aria-label="Every story — drag to explore">
    <div class="canvas__world" data-world>
      {
        Array.from({ length: COPIES * COPIES }, (_, copy) =>
          stories.map((s, i) => (
            <a
              class="tile"
              href={`/story/${s.slug}`}
              data-tile
              data-i={i}
              data-copy={copy}
              data-slug={s.slug}
              data-tags={JSON.stringify(s.tags)}
              tabindex={copy === 4 ? undefined : -1}
              aria-hidden={copy === 4 ? undefined : 'true'}
              draggable="false"
              data-cursor="view"
              data-cursor-label="View story →"
            >
              <span class="tile__frame" style={`aspect-ratio:${Math.min(1.4, Math.max(0.7, s.coverAspect))}`}>
                <img src={s.coverSm} alt="" loading="lazy" decoding="async" draggable="false" />
                {s.slug === newest && <span class="badge-new tile__new">NEW</span>}
              </span>
              <span class="tile__meta">
                <span class="tile__title">{s.title}</span>
                <span class="label label--dim">{[...s.tags, s.year].join(' · ')}</span>
              </span>
            </a>
          )),
        )
      }
    </div>

    <div class="canvas__top">
      <p class="label"><span data-count>{stories.length}</span> stories</p>
      <div class="chips" role="group" aria-label="Filter by tag">
        <button type="button" class="chip label" data-tag="" aria-pressed="true">All</button>
        {tags.map(([t]) => <button type="button" class="chip label" data-tag={t} aria-pressed="false">{t}</button>)}
      </div>
    </div>

    <div class="canvas__zoom">
      <button type="button" class="zoom label" data-zoom="-1" aria-label="Zoom out">−</button>
      <span class="label label--dim" data-zoom-level>100%</span>
      <button type="button" class="zoom label" data-zoom="1" aria-label="Zoom in">+</button>
      <button type="button" class="zoom label zoom--reset" data-zoom="0">Reset</button>
    </div>
    <p class="canvas__hint label label--dim" data-hint>Drag or scroll to explore · pinch or +/− to zoom</p>
  </section>

  <!-- phones: two-up grid -->
  <main class="page grid-fallback">
    <p class="label label--dim">Archive</p>
    <p class="display">Every story.</p>
    <ul class="gridf">
      {
        stories.map((s) => (
          <li>
            <a href={`/story/${s.slug}`}>
              <span class="gridf__frame">
                <img src={s.coverSm} alt="" loading="lazy" decoding="async" />
              </span>
              <span class="tile__title">{s.title}</span>
              <span class="label label--dim">{[...s.tags, s.year].join(' · ')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style is:global>
  @media (hover: hover) and (min-width: 761px) {
    body.av2-body { overflow: hidden; overscroll-behavior: none; }
  }
</style>

<style>
  .canvas { position: fixed; inset: 0; overflow: hidden; background: radial-gradient(70% 60% at 50% 45%, #18120f, var(--bg) 75%); cursor: grab; touch-action: none; user-select: none; }
  .canvas:global(.is-dragging) { cursor: grabbing; }
  .canvas__world { position: absolute; left: 0; top: 0; width: 0; height: 0; }
  .tile { position: absolute; left: 0; top: 0; width: 240px; display: grid; gap: 10px; will-change: transform; transition: opacity 0.6s var(--ease); }
  .tile__frame { position: relative; display: block; overflow: hidden; border-radius: 6px; background: var(--bg-3); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45); transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease); }
  .tile__frame img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; filter: saturate(0.9) brightness(0.9); transition: filter 0.6s var(--ease), transform 1.2s var(--ease); }
  .tile__new { position: absolute; left: 10px; top: 10px; }
  .tile__meta { display: grid; gap: 4px; opacity: 0; transform: translateY(-6px); transition: opacity 0.5s var(--ease), transform 0.5s var(--ease); }
  .tile__title { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.5rem; line-height: 1.05; }
  @media (hover: hover) {
    .tile:hover .tile__frame { transform: translateY(-6px) scale(1.03); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.6); }
    .tile:hover .tile__frame img { filter: saturate(1.04) brightness(1); transform: scale(1.04); }
    .tile:hover .tile__meta { opacity: 1; transform: none; }
  }
  .tile:focus-visible .tile__meta { opacity: 1; transform: none; }
  .tile:global(.is-out) { opacity: 0.08; pointer-events: none; }

  .canvas__top { position: absolute; left: 50%; top: 88px; transform: translateX(-50%); z-index: 5; display: grid; justify-items: center; gap: 12px; max-width: calc(100vw - 32px); }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; padding: 5px; border-radius: 22px; background: rgba(12, 10, 9, 0.55); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid var(--line); }
  .chip { height: 32px; padding: 0 13px; border-radius: 999px; color: var(--ink-2); transition: all 0.4s var(--ease); }
  @media (hover: hover) { .chip:hover { color: var(--ink); } }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--bg); }

  .canvas__zoom { position: absolute; right: var(--gutter); bottom: 88px; z-index: 5; display: flex; align-items: center; gap: 4px; padding: 4px; border-radius: 999px; background: rgba(12, 10, 9, 0.55); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid var(--line); }
  .zoom { width: 34px; height: 34px; border-radius: 50%; font-size: 16px; color: var(--ink); }
  .zoom--reset { width: auto; padding: 0 12px; font-size: 10px; border-radius: 999px; }
  @media (hover: hover) { .zoom:hover { background: rgba(236, 228, 218, 0.1); } }
  [data-zoom-level] { min-width: 44px; text-align: center; font-variant-numeric: tabular-nums; }
  .canvas__hint { position: absolute; left: 50%; bottom: 96px; transform: translateX(-50%); z-index: 5; transition: opacity 1s var(--ease); pointer-events: none; }
  .canvas__hint:global(.is-gone) { opacity: 0; }

  .grid-fallback { display: none; }
  .gridf { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 10px; }
  .gridf a { display: grid; gap: 6px; }
  .gridf__frame { display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 3px; background: var(--bg-3); }
  .gridf__frame img { width: 100%; height: 100%; object-fit: cover; }
  .gridf .tile__title { font-size: 1.35rem; }
  .gridf .label { font-size: 9.5px; letter-spacing: 0.1em; }

  /* Phones & touch: the canvas steps aside for a plain grid. */
  @media (hover: none), (max-width: 760px) {
    .canvas { display: none; }
    .grid-fallback { display: block; }
  }
</style>

<script>
  import { onPage, isFinePointer, prefersReducedMotion } from '../../scripts/lifecycle.js';
  import { heroName } from '../../lib/vt.js';

  onPage(() => {
    const canvas = document.querySelector('[data-canvas]');
    if (!canvas || getComputedStyle(canvas).display === 'none' || !isFinePointer()) return;
    const reduced = prefersReducedMotion();
    const tiles = [...canvas.querySelectorAll('[data-tile]')];
    const n = tiles.length / 9;

    // Layout of one world block: a staggered grid.
    const COLS = Math.max(4, Math.ceil(Math.sqrt(n * 1.6)));
    const ROWS = Math.ceil(n / COLS);
    const CW = 330; // cell width
    const CH = 420; // cell height
    const W = COLS * CW;
    const H = ROWS * CH;
    const base = tiles.map((el) => {
      const i = Number(el.dataset.i);
      const copy = Number(el.dataset.copy);
      const col = i % COLS;
      const row = Math.floor(i / COLS);
      const seed = Math.sin((i + 1) * 12.9898) * 0.5 + 0.5;
      return {
        el,
        seed,
        x: col * CW + (row % 2) * (CW / 2) + (seed - 0.5) * 60 + (copy % 3) * W,
        y: row * CH + (col % 2) * 70 + (seed - 0.5) * 40 + Math.floor(copy / 3) * H,
      };
    });

    let panX = -W - W / 2 + window.innerWidth / 2;
    let panY = -H - H / 2 + window.innerHeight / 2;
    let tx = panX, ty = panY, vx = 0, vy = 0;
    let zoom = 1, tz = 1;
    const ZMIN = 0.45, ZMAX = 1.7;
    const level = canvas.querySelector('[data-zoom-level]');
    const hint = canvas.querySelector('[data-hint]');
    const hideHint = () => hint.classList.add('is-gone');

    let drag = null;
    let moved = 0;
    const down = (e) => {
      moved = 0;
      if (e.button !== 0 || e.target.closest('.canvas__top, .canvas__zoom')) return;
      drag = { x: e.clientX, y: e.clientY };
      moved = 0;
      vx = vy = 0;
    };
    const move = (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      drag = { x: e.clientX, y: e.clientY };
      moved += Math.abs(dx) + Math.abs(dy);
      if (moved > 5) {
        canvas.classList.add('is-dragging');
        hideHint();
      }
      tx += dx / zoom;
      ty += dy / zoom;
      vx = dx / zoom;
      vy = dy / zoom;
    };
    const up = () => {
      drag = null;
      canvas.classList.remove('is-dragging');
    };
    // A drag must not also open a story.
    const click = (e) => {
      if (e.target.closest('.canvas__top, .canvas__zoom')) return;
      if (moved > 5) {
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      const a = e.target.closest('[data-tile]');
      if (a) a.querySelector('img').style.viewTransitionName = heroName(a.dataset.slug);
    };
    const zoomAt = (factor, cx = window.innerWidth / 2, cy = window.innerHeight / 2) => {
      const nz = Math.min(ZMAX, Math.max(ZMIN, tz * factor));
      // keep the point under the cursor fixed
      tx -= (cx - window.innerWidth / 2) * (1 / tz - 1 / nz);
      ty -= (cy - window.innerHeight / 2) * (1 / tz - 1 / nz);
      tz = nz;
      hideHint();
    };
    const wheel = (e) => {
      e.preventDefault();
      if (e.ctrlKey) zoomAt(Math.exp(-e.deltaY * 0.01), e.clientX, e.clientY); // pinch
      else {
        tx -= e.deltaX / tz;
        ty -= e.deltaY / tz;
        hideHint();
      }
    };
    const onZoomBtn = (e) => {
      const d = Number(e.currentTarget.dataset.zoom);
      if (d === 0) {
        tz = 1;
      } else zoomAt(d > 0 ? 1.25 : 0.8);
    };
    const key = (e) => {
      const step = 120 / tz;
      if (e.key === 'ArrowLeft') tx += step;
      else if (e.key === 'ArrowRight') tx -= step;
      else if (e.key === 'ArrowUp') ty += step;
      else if (e.key === 'ArrowDown') ty -= step;
      else if (e.key === '+' || e.key === '=') zoomAt(1.2);
      else if (e.key === '-') zoomAt(0.83);
      else return;
      e.preventDefault();
    };

    // filters
    const chips = [...canvas.querySelectorAll('.chip')];
    const count = canvas.querySelector('[data-count]');
    const onChip = (e) => {
      const tag = e.currentTarget.dataset.tag;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === e.currentTarget)));
      let shown = 0;
      base.forEach((b, k) => {
        const match = !tag || JSON.parse(b.el.dataset.tags).includes(tag);
        b.el.classList.toggle('is-out', !match);
        if (match && k < n) shown++;
      });
      count.textContent = String(shown);
    };

    canvas.addEventListener('pointerdown', down);
    window.addEventListener('pointermove', move, { passive: true });
    window.addEventListener('pointerup', up);
    canvas.addEventListener('click', click, true);
    canvas.addEventListener('wheel', wheel, { passive: false });
    window.addEventListener('keydown', key);
    canvas.querySelectorAll('[data-zoom]').forEach((b) => b.addEventListener('click', onZoomBtn));
    chips.forEach((c) => c.addEventListener('click', onChip));

    const mod = (a, m) => ((a % m) + m) % m;
    const t0 = performance.now();
    let raf = 0;
    const loop = (now) => {
      raf = requestAnimationFrame(loop);
      const time = (now - t0) / 1000;
      if (!drag && !reduced) {
        tx += vx;
        ty += vy;
        vx *= 0.93;
        vy *= 0.93;
      }
      const k = reduced ? 1 : 0.12;
      panX += (tx - panX) * k;
      panY += (ty - panY) * k;
      zoom += (tz - zoom) * k;
      level.textContent = `${Math.round(tz * 100)}%`;
      // how fast we're moving → frames lean into the motion
      const lean = reduced ? 0 : Math.max(-8, Math.min(8, (tx - panX) * 0.04));
      const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
      for (const b of base) {
        // wrap into [-W, 2W) so the 3×3 world always surrounds the viewport
        const wx = mod(b.x + panX, W * 3) - W;
        const wy = mod(b.y + panY, H * 3) - H;
        const sx = cx + (wx - cx) * zoom;
        const sy = cy + (wy - cy) * zoom;
        const bob = reduced ? 0 : Math.sin(time * 0.6 + b.seed * 10) * 6;
        const turn = reduced ? 0 : Math.sin(time * 0.35 + b.seed * 20) * 1.6 + lean * (0.5 + b.seed);
        b.el.style.transform = `translate3d(${sx}px, ${sy + bob * zoom}px, 0) rotate(${turn}deg) scale(${zoom})`;
      }
    };
    raf = requestAnimationFrame(loop);

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      window.removeEventListener('keydown', key);
    };
  });
</script>
