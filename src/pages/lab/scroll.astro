---
import Base from '../../layouts/Base.astro';
import { getFeatured, metaLine } from '../../lib/content.js';
import { heroName } from '../../lib/vt.js';

const featured = await getFeatured();
---

<Base title="Lab — Scroll-Story" noindex>
  <main class="scenes">
    {
      featured.map((s, i) => (
        <section class="scene" data-scene>
          <div class="scene__sticky">
            <img class="scene__img" src={s.cover} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" style={`view-transition-name:${heroName(s.slug)}`} />
            <div class="scene__shade" />
            <div class="scene__text">
              <p class="label">{String(i + 1).padStart(2, '0')} {i === 0 && <span class="badge-new">NEW</span>}</p>
              <h2 class="display">
                <a href={`/story/${s.slug}`}>{s.title}</a>
              </h2>
              <p class="label label--dim">{metaLine(s).slice(0, -2).join(' · ')}</p>
            </div>
          </div>
        </section>
      ))
    }
  </main>
</Base>

<style>
  .scene { height: 180vh; position: relative; }
  .scene__sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .scene__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(calc(1.18 - var(--p, 0) * 0.18)); filter: brightness(calc(0.55 + var(--p, 0) * 0.35)) saturate(0.9); will-change: transform; }
  .scene__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(12, 10, 9, 0.85), transparent 60%); }
  .scene__text { position: absolute; left: var(--gutter); bottom: 14vh; display: grid; gap: 18px; opacity: calc(var(--p, 0) * 1.6 - 0.2); transform: translateY(calc((1 - var(--p, 0)) * 60px)); }
</style>

<script>
  import { onPage, prefersReducedMotion } from '../../scripts/lifecycle.js';
  onPage(() => {
    const scenes = [...document.querySelectorAll('[data-scene]')];
    if (!scenes.length) return;
    if (prefersReducedMotion()) {
      scenes.forEach((s) => s.style.setProperty('--p', '1'));
      return;
    }
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const s of scenes) {
        const r = s.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh - r.top) / (r.height * 0.6)));
        s.style.setProperty('--p', p.toFixed(3));
      }
    };
    const onScroll = () => (raf ||= requestAnimationFrame(update));
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    return () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      cancelAnimationFrame(raf);
    };
  });
</script>
