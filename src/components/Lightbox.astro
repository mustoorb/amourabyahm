---
// Photo lightbox: ‹ › arrows, arrow keys, swipe, counter, wrap-around, neighbour preload.
// Opens for any [data-lb-index] button on the page; reads data-full / data-alt from it.
---

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <div class="lightbox__stage" data-lb-stage tabindex="-1" autofocus>
    <img class="lightbox__img" data-lb-img alt="" />
  </div>
  <p class="lightbox__count label" aria-live="polite"><span data-lb-count>1</span> / <span data-lb-total>1</span></p>
  <button class="lightbox__close label" type="button" data-lb-close>Close <span aria-hidden="true">✕</span></button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label="Previous photo">‹</button>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label="Next photo">›</button>
</dialog>

<style>
  .lightbox { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(8, 7, 6, 0.97); color: var(--ink); overflow: hidden; }
  .lightbox::backdrop { background: rgba(8, 7, 6, 0.9); }
  .lightbox[open] { animation: lb-in 0.6s var(--ease); }
  @keyframes lb-in { from { opacity: 0; } }
  .lightbox__stage { position: absolute; inset: 64px 72px; touch-action: pan-y; outline: none; }
  .lightbox__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; user-select: none; -webkit-user-drag: none; transition: opacity 0.45s var(--ease), transform 0.45s var(--ease); }
  .lightbox__img.is-loading { opacity: 0; transform: scale(0.985); }
  .lightbox__count { position: absolute; left: var(--gutter); top: 24px; font-variant-numeric: tabular-nums; }
  .lightbox__close { position: absolute; right: var(--gutter); top: 18px; padding: 8px 0; }
  .lightbox__nav { position: absolute; top: 50%; transform: translateY(-50%); width: 56px; height: 96px; font-family: var(--serif); font-size: 54px; line-height: 1; color: var(--ink-2); transition: color 0.4s var(--ease); }
  .lightbox__nav:hover { color: var(--ink); }
  .lightbox__nav--prev { left: 8px; }
  .lightbox__nav--next { right: 8px; }
  @media (max-width: 760px) {
    .lightbox__stage { inset: 60px 0 40px; }
    .lightbox__nav { top: auto; bottom: 8px; transform: none; height: 56px; font-size: 40px; }
  }
</style>

<script>
  import { onPage } from '../scripts/lifecycle.js';

  onPage(() => {
    const dlg = document.querySelector('[data-lightbox]');
    const triggers = [...document.querySelectorAll('[data-lb-index]')];
    if (!dlg || !triggers.length) return;

    const img = dlg.querySelector('[data-lb-img]');
    const count = dlg.querySelector('[data-lb-count]');
    const stage = dlg.querySelector('[data-lb-stage]');
    dlg.querySelector('[data-lb-total]').textContent = String(triggers.length);
    const items = triggers.map((t) => ({ src: t.dataset.full, alt: t.dataset.alt || '' }));
    const cache = new Map();
    let i = 0;
    let lastTrigger = null;

    const preload = (k) => {
      const it = items[(k + items.length) % items.length];
      if (!cache.has(it.src)) {
        const im = new Image();
        im.decoding = 'async';
        im.src = it.src;
        cache.set(it.src, im);
      }
    };

    function show(k) {
      i = (k + items.length) % items.length;
      const it = items[i];
      count.textContent = String(i + 1);
      img.classList.add('is-loading');
      const done = () => img.classList.remove('is-loading');
      const next = new Image();
      next.src = it.src;
      (next.decode ? next.decode() : Promise.resolve()).catch(() => {}).then(() => {
        if (items[i] !== it) return;
        img.src = it.src;
        img.alt = it.alt;
        done();
      });
      preload(i + 1);
      preload(i - 1);
    }

    const open = (e) => {
      lastTrigger = e.currentTarget;
      dlg.showModal();
      show(Number(lastTrigger.dataset.lbIndex));
    };
    const close = () => dlg.close();
    const prev = () => show(i - 1);
    const next = () => show(i + 1);
    const onKey = (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowLeft') prev();
      else if (e.key === 'ArrowRight') next();
    };
    const onClose = () => lastTrigger?.focus({ preventScroll: true });
    const onBackdrop = (e) => {
      if (e.target === dlg || e.target === stage) close();
    };

    // swipe
    let sx = 0, sy = 0, active = false;
    const down = (e) => { active = true; sx = e.clientX; sy = e.clientY; };
    const up = (e) => {
      if (!active) return;
      active = false;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.3) (dx < 0 ? next : prev)();
    };

    triggers.forEach((t) => t.addEventListener('click', open));
    dlg.querySelector('[data-lb-close]').addEventListener('click', close);
    dlg.querySelector('[data-lb-prev]').addEventListener('click', prev);
    dlg.querySelector('[data-lb-next]').addEventListener('click', next);
    dlg.addEventListener('click', onBackdrop);
    dlg.addEventListener('close', onClose);
    stage.addEventListener('pointerdown', down);
    stage.addEventListener('pointerup', up);
    window.addEventListener('keydown', onKey);

    return () => {
      window.removeEventListener('keydown', onKey);
      if (dlg.open) dlg.close();
    };
  });
</script>
